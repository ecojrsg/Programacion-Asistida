    1: """Check three initial requirements from the parking specification."""
       
    1: import unittest
       
    1: from parking_lot import calculate_toll
       
       
    2: class InitialTollTests(unittest.TestCase):
    1:     """Check validation, free parking, and a supplied billing example."""
       
    1:     def test_negative_minutes_raise_value_error(self):
               """Reject a stay with negative minutes."""
    2:         with self.assertRaises(ValueError):
    1:             calculate_toll(-1)
       
    1:     def test_first_fifteen_minutes_are_free(self):
               """Charge nothing at the end of the free period."""
    1:         self.assertEqual(calculate_toll(15), 0)
       
    1:     def test_ninety_minutes_cost_forty_for_auto(self):
               """Round ninety minutes up to two billable hours."""
    1:         self.assertEqual(calculate_toll(90), 40)
