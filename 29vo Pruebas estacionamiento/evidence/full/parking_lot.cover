       #!/usr/bin/env python3
       # -*- coding: utf-8 -*-
    1: """
       Developer: .
       Creation Date: 2026-10-26.
       Description: Parking lot excercise.
       """
       
    1: import math
       
       
    1: def calculate_toll(minutes: float, type: str = "auto", weekend: bool = False) -> int:
   34:     if minutes < 0:
    1:         raise ValueError("Minutes cannot be negative")
   33:     if minutes <= 15:
    6:         return 0
       
   27:     hours = math.ceil(minutes / 60)
   27:     if type == "auto":
   15:         toll = 20
   12:     elif type == "moto":
   10:         toll = 10
    2:     elif type == "pension":
    1:         return 0
           else:
    1:         raise ValueError("Invalid vehicle type.")
   25:     total = hours * toll
   25:     if weekend:
    9:         total *= 1.5
   25:     return min(total, 200)
